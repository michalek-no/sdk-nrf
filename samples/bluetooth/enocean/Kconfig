# Controller configuration. On multi-core devices the controller runs on its own
# core, so these symbols only exist when the controller is part of this image.

configdefault BT_CTLR_DUP_FILTER_LEN
	default 0

source "Kconfig.zephyr"

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
